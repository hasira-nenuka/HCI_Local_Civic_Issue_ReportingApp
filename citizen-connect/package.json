{
  "name": "citizen-connect",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "eslint": "9",
    "eslint-config-expo": "~57.0.2",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58",
    "@types/react": "~19.2.2",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain.test.mjs",
    "test:e2e": "playwright test",
    "export:web": "expo export --platform web",
    "export:android": "expo export --platform android --output-dir dist-android",
    "format": "prettier --write App.tsx index.ts navigation screens src hooks types constants services utils components tests playwright.config.ts eslint.config.js app.json app.config.ts package.json tsconfig.json firebase.json eas.json",
    "format:check": "prettier --check App.tsx index.ts navigation screens src hooks types constants services utils components tests playwright.config.ts eslint.config.js app.json app.config.ts package.json tsconfig.json firebase.json eas.json",
    "lint": "expo lint"
  },
  "private": true
}
