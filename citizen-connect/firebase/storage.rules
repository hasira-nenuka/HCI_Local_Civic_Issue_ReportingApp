rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function active() { return request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true; }
    match /photos/{userId}/{filename} {
      allow read: if active() && (request.auth.uid == userId || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'officer', 'gn']);
      allow create: if active() && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if active() && request.auth.uid == userId;
    }
  }
}
